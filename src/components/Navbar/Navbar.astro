---
import { TbUfo } from "react-icons/tb"
import { HiMenu, HiX } from "react-icons/hi"

interface Props {
  links?: { label: string; href: string }[]
}

const DEFAULT_LINKS = [
  { label: "Home", href: "/" },
  { label: "Sobre mí", href: "/#Sobre-mi" },
  { label: "Tecnologías", href: "/#Tecnológias" },
  { label: "Proyectos", href: "/#Proyectos" },
  { label: "Contáctame", href: "/Contactame" },
]

const { links = DEFAULT_LINKS } = Astro.props
---

<header class='w-full fixed z-50 px-4 py-4'>
  <nav
    id='navbar-desktop'
    class='relative mx-auto hidden md:flex w-[1120px] max-w-[calc(100%-2rem)] items-center justify-between rounded-2xl border border-white/10 bg-[#0b0b0d]/70 px-4 py-3 backdrop-blur-lg shadow-sm transition-shadow duration-300 hover:shadow-md'
    aria-label='Principal'
  >
    <a class='px-2 font-bold text-lg text-white' href='/'>Jeremy Amaru</a>
    <div id='links-wrap' class='relative flex items-center gap-1'>
      <span
        id='indicator'
        class='pointer-events-none absolute inset-y-0 rounded-lg border border-white/10 bg-white/10 transition-all duration-300 ease-out'
        aria-hidden='true'></span>
      {
        links.map((link, i) => (
          <a
            href={link.href}
            data-index={i}
            class='nav-link relative z-10 rounded-lg px-4 py-2 text-sm font-medium transition-colors duration-300'
          >
            {link.label}
          </a>
        ))
      }
    </div>
    <span
      class='p-2 text-white transition-transform duration-300 hover:rotate-12'
    >
      <TbUfo size={28} />
    </span>
  </nav>

  <div
    class='flex items-center justify-between rounded-2xl border border-white/10 bg-[#0b0b0d]/80 px-4 py-3 backdrop-blur-lg md:hidden'
  >
    <a class='text-lg font-bold text-white' href='/'>Jeremy Amaru</a>
    <button
      id='menu-btn'
      class='flex h-9 w-9 items-center justify-center rounded-xl border border-white/10 text-white transition-colors duration-300 hover:bg-white/5'
      aria-label='Abrir menú'
      aria-expanded='false'
    >
      <span class='relative block h-5 w-5'>
        <span
          id='icon-menu'
          class='absolute inset-0 flex items-center justify-center transition-all duration-300'
          ><HiMenu size={20} /></span
        >
        <span
          id='icon-close'
          class='absolute inset-0 flex items-center justify-center opacity-0 -rotate-90 transition-all duration-300'
          ><HiX size={20} /></span
        >
      </span>
    </button>
  </div>

  <div
    id='mobile-menu'
    class='grid grid-rows-[0fr] overflow-hidden opacity-0 transition-all duration-300 md:hidden'
  >
    <div class='min-h-0 pt-2'>
      <div
        class='flex flex-col gap-1 rounded-2xl border border-white/10 bg-[#0b0b0d]/90 p-2 backdrop-blur-lg'
      >
        {
          links.map((link) => (
            <a
              href={link.href}
              class='mobile-link rounded-lg px-4 py-2.5 text-center text-sm font-medium text-white/70 transition-colors duration-200 hover:bg-white/5 hover:text-white'
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</header>

<script>
  import { setupNavbar } from "./navbar-client"
  setupNavbar()
</script>
