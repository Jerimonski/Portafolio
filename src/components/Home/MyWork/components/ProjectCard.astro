---
const { Title, Rol, Year, image, repoUrl } = Astro.props
---

<div
  class='py-6 space-y-2 transition-all duration-300 group-hover:opacity-40 hover:opacity-100'
>
  <figure class='overflow-hidden rounded-xl'>
    <a href={`/${Title}`} class='block'>
      <img
        src={image}
        alt={`Imagen ${Title}`}
        class='w-full h-64 object-fit transition-transform duration-300 ease-out hover:scale-110'
      />
    </a>
  </figure>

  <article class='space-y-2 py-4'>
    <h3 class='text-lg'>{Title}</h3>

    <p class='flex justify-between text-sm text-secondary-text'>
      {Rol}
      <span>{Year}</span>
    </p>
  </article>

  <slot />

  <div class='flex gap-8 text-center [&>a]:py-2 [&>a]:rounded-xl'>
    <a
      href={repoUrl}
      target='_blank'
      class='w-full bg-darker-green text-lg font-extrabold transition-opacity duration-300 group-hover:opacity-40 hover:opacity-100'
    >
      Ver Repositorio
    </a>

    <a
      href={`/${Title}`}
      class='w-full border border-secondary-text bg-black text-lg font-extrabold transition-opacity duration-300 group-hover:opacity-40 hover:opacity-100'
    >
      Más detalles
    </a>
  </div>
</div>
