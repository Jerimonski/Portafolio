---
import TecsContent from "./components/TecsContent.astro"
import { Icons } from "./TechsIcons/FrontendIcons"
const icons = Icons.Frontend
---

<TecsContent>
  {
    icons.map((icon) => (
      <a href={icon.page} target={"_blank"}>
        <div>
          <icon.icon />
          <span>{icon.name}</span>
        </div>
      </a>
    ))
  }
</TecsContent>
